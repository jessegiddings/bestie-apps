{
  "expo": {
    "name": "Dry Tracker",
    "slug": "dry-tracker",
    "version": "0.1.0",
    "scheme": "drytracker",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F6F2",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.bestie.drytracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.bestie.drytracker",
      "adaptiveIcon": {
        "backgroundColor": "#F3F6F2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#1F6F5B"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F6F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
