{
  "expo": {
    "name": "Dry & Mighty",
    "slug": "dry-and-mighty",
    "version": "0.1.0",
    "scheme": "dryandmighty",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#100E1A",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.bestie.dryandmighty",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.bestie.dryandmighty",
      "adaptiveIcon": {
        "backgroundColor": "#100E1A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#F7B58F"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100E1A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
