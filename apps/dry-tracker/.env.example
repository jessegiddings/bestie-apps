# Real billing requires native build + public RevenueCat SDK keys. Missing keys disable billing.
# Explicit preview applies only to development builds; ignored in production.
EXPO_PUBLIC_PREVIEW_MODE=true
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Supabase project for buddy pairing. Without them pairing shows as "not set up yet".
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
