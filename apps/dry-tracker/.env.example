# RevenueCat public SDK keys. Without them the app runs in mock mode (purchases are simulated).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Supabase project for buddy pairing. Without them pairing shows as "not set up yet".
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
