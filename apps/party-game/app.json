{
  "expo": {
    "name": "Bestie Night",
    "slug": "party-game",
    "version": "0.1.0",
    "scheme": "bestienight",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F3ED",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.bestie.partygame",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.bestie.partygame",
      "adaptiveIcon": {
        "backgroundColor": "#FFF7EE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F3ED"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
